{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mvl-slack-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "placement": {
    "mode": "smart",
    "hint": "enam"
  },
  "vars": {
    "AI_PROVIDER": "gemini",
    "DEFAULT_MODEL": "gemini-3.6-flash",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "PLANE_API_HOST_URL": "https://pm.glinteco.com",
    "PLANE_WORKSPACE_SLUG": "glinteco",
    "PLANE_DEFAULT_PROJECT_ID": "e92f7ba8-0db9-487f-a21c-13712d226eb8",
    "CLICKUP_DEFAULT_LIST_ID": "901818745715"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "15e112fb617444adb5a2abd2055970b1"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mvl-srs-db",
      "database_id": "249f00c2-7129-4179-af20-9c7c34751423"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "mvl-srs-vectors"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
